{
  "rules": {
    ".read": false,
    ".write": false,
    "adminConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@bilnetoyun.com'"
    },
    "leaderboards": {
      ".read": false,
      "space-waves": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        "$entryId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name','score','timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "timestamp": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "egim": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        "$entryId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name','score','timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "timestamp": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "tetris": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        "$entryId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name','score','timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "timestamp": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "lobbies": {
      ".read": true,
      ".indexOn": [
        "state"
      ],
      "$lobbyId": {
        ".write": "$lobbyId.matches(/^[A-Z]{5}$/)",
        "id": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{5}$/)"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "guestName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "gameType": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "wordLength": {
          ".validate": "newData.isNumber()"
        },
        "maxTurns": {
          ".validate": "newData.isNumber()"
        },
        "gridSize": {
          ".validate": "newData.isNumber()"
        },
        "totalRounds": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "players": {
      ".read": true,
      "$playerId": {
        ".write": "$playerId.matches(/^P[a-z0-9]{10,16}$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      ".read": true,
      "altin-avi": {
        ".indexOn": [
          "state"
        ],
        "$code": {
          ".write": "$code.matches(/^[A-Z]{5}$/)",
          "state": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "players": {
            "$playerId": {
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "gold": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
              }
            }
          }
        }
      },
      "son-kart": {
        ".indexOn": [
          "state"
        ],
        "$code": {
          ".write": "$code.matches(/^[A-Z2-9]{4}$/)",
          "state": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "names": {
            "$pid": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            }
          }
        }
      },
      "kelimelik": {
        ".indexOn": [
          "state"
        ],
        "$code": {
          ".write": "$code.matches(/^[A-Z2-9]{4}$/)",
          "state": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "names": {
            "$pid": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
