{
  "rules": {
    ".read": false,
    ".write": false,
    "adminConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@bilnetoyun.com'"
    },
    "leaderboards": {
      ".read": false,
      "space-waves": {
        ".read": true,
        ".indexOn": ["score"],
        "$entryId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name','score','timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "timestamp": {
            ".validate": "newData.val() == now"
          },
          "$other": { ".validate": false }
        }
      },
      "egim": {
        ".read": true,
        ".indexOn": ["score"],
        "$entryId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name','score','timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "timestamp": {
            ".validate": "newData.val() == now"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "lobbies": {
      ".read": true,
      ".write": true,
      ".indexOn": ["state"],
      "$lobbyId": {
        "hostName":  { ".validate": "newData.isString() && newData.val().length <= 24" },
        "guestName": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "state":     { ".validate": "newData.isString() && newData.val().length <= 24" },
        "gameType":  { ".validate": "newData.isString() && newData.val().length <= 32" }
      }
    },
    "players": {
      ".read": true,
      ".write": true,
      "$playerId": {
        "name":     { ".validate": "newData.isString() && newData.val().length <= 24" },
        "online":   { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other":   { ".validate": false }
      }
    },
    "rooms": {
      ".read": true,
      ".write": true,
      "altin-avi": {
        ".indexOn": ["state"],
        "$code": {
          "state":    { ".validate": "newData.isString() && newData.val().length <= 24" },
          "players": {
            "$playerId": {
              "name": { ".validate": "newData.isString() && newData.val().length <= 24" }
            }
          }
        }
      }
    }
  }
}
