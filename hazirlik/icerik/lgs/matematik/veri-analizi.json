    { "id": "lgs-mat-veri-analizi-039", "zorluk": "orta", "soru": "Bir öğrencinin dört sınav notundan üçü 60, 70 ve 80'dir. Not ortalaması 75 ise dördüncü not kaçtır?", "siklar": { "A": "75", "B": "85", "C": "90", "D": "80" }, "dogruCevap": "C", "cozum": "Toplam = 75×4 = 300. Dördüncü = 300 − (60+70+80) = 300 − 210 = 90.", "kazanim": "Eksik veriyi ortalamadan bulur.", "dogrulandi": true },
    { "id": "lgs-mat-veri-analizi-040", "zorluk": "orta", "soru": "25, 35, 45 verilerinin aritmetik ortalaması kaçtır?", "siklar": { "A": "45", "B": "25", "C": "105", "D": "35" }, "dogruCevap": "D", "cozum": "(25+35+45)/3 = 105/3 = 35.", "kazanim": "Aritmetik ortalama bulur.", "dogrulandi": true },
