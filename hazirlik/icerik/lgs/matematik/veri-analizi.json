          { "soru": "5, 8, 8, 11 verilerinin aritmetik ortalaması nedir?", "adimlar": ["Topla: 5+8+8+11 = 32", "Veri sayısına böl: 32 ÷ 4 = 8"], "sonuc": "Ortalama = 8" },
          { "soru": "3, 7, 9, 12, 15 verilerinin ortancası nedir?", "adimlar": ["Sıralı (zaten sıralı), 5 veri var", "Tam ortadaki 3. değer: 9"], "sonuc": "Ortanca = 9" },
          { "soru": "2, 4, 6, 8 verilerinin ortancası nedir?", "adimlar": ["4 veri (çift sayıda)", "Ortadaki ikisi: 4 ve 6", "Ortalaması: (4+6)/2 = 5"], "sonuc": "Ortanca = 5" }
        ]
      },
      {
        "tip": "kavram",
        "baslik": "4. Açıklık ve Grafik Türleri",
        "kutular": [
