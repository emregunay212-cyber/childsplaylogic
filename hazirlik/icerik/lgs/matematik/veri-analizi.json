    { "id": "lgs-mat-veri-analizi-014", "zorluk": "orta", "soru": "5 sayının aritmetik ortalaması 6'dır. Bu sayıların toplamı kaçtır?", "siklar": { "A": "30", "B": "11", "C": "1.2", "D": "25" }, "dogruCevap": "A", "cozum": "Toplam = ortalama × adet = 6 × 5 = 30.", "kazanim": "Ortalamadan toplama ulaşır.", "dogrulandi": true },
