    { "id": "lgs-mat-veri-analizi-091", "zorluk": "zor", "soru": "5 sayının aritmetik ortalaması 54'tür. Bunlardan dördü 45, 50, 55 ve 60 ise beşinci sayı kaçtır?", "siklar": { "A": "54", "B": "50", "C": "60", "D": "55" }, "dogruCevap": "C", "cozum": "Toplam = 54×5 = 270. Beşinci = 270 − (45+50+55+60) = 270 − 210 = 60.", "kazanim": "Eksik veriyi ortalamadan bulur.", "dogrulandi": true },
