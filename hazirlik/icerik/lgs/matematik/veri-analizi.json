    { "id": "lgs-mat-veri-analizi-044", "zorluk": "zor", "soru": "Beş sayının ortalaması 20'dir. Bu sayıların dördü 10, 15, 25 ve 30 ise beşinci sayı kaçtır?", "siklar": { "A": "15", "B": "25", "C": "30", "D": "20" }, "dogruCevap": "D", "cozum": "Toplam = 20×5 = 100. Beşinci = 100 − (10+15+25+30) = 100 − 80 = 20.", "kazanim": "Eksik veriyi ortalamadan bulur.", "dogrulandi": true },
