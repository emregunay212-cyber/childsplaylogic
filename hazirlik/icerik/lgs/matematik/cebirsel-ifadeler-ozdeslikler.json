    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-028", "zorluk": "kolay", "soru": "x · x çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "2x", "B": "x", "C": "2x²", "D": "x²" }, "dogruCevap": "D", "cozum": "x · x = x².", "kazanim": "Değişkenli çarpımı yapar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-029", "zorluk": "kolay", "soru": "6x + 2x ifadesinin sadeleştirilmiş hâli aşağıdakilerden hangisidir?", "siklar": { "A": "8x", "B": "4x", "C": "8x²", "D": "12x" }, "dogruCevap": "A", "cozum": "6x + 2x = 8x.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-030", "zorluk": "kolay", "soru": "5(x − 1) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "5x + 5", "B": "5x − 5", "C": "5x − 1", "D": "6x − 5" }, "dogruCevap": "B", "cozum": "5(x − 1) = 5x − 5.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-031", "zorluk": "kolay", "soru": "2x + 5 + 3x ifadesinin sadeleştirilmiş hâli aşağıdakilerden hangisidir?", "siklar": { "A": "10x", "B": "5x + 6", "C": "5x + 5", "D": "6x + 5" }, "dogruCevap": "C", "cozum": "2x + 3x + 5 = 5x + 5.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-032", "zorluk": "kolay", "soru": "x(x + 3) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 3", "B": "3x²", "C": "x² − 3x", "D": "x² + 3x" }, "dogruCevap": "D", "cozum": "x(x + 3) = x² + 3x.", "kazanim": "Tek terimle çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-033", "zorluk": "orta", "soru": "(x − 1)(x + 4) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 3x − 4", "B": "x² − 3x − 4", "C": "x² + 3x + 4", "D": "x² − 4" }, "dogruCevap": "A", "cozum": "(x − 1)(x + 4) = x² + 4x − x − 4 = x² + 3x − 4.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-034", "zorluk": "orta", "soru": "(x − 2)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² − 4", "B": "x² − 4x + 4", "C": "x² + 4x + 4", "D": "x² − 2x + 4" }, "dogruCevap": "B", "cozum": "(x − 2)² = x² − 2·x·2 + 4 = x² − 4x + 4.", "kazanim": "(a − b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-035", "zorluk": "orta", "soru": "(x + 6)(x − 6) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 36", "B": "x − 36", "C": "x² − 36", "D": "x² − 12x + 36" }, "dogruCevap": "C", "cozum": "İki kare farkı: (x + 6)(x − 6) = x² − 36.", "kazanim": "İki kare farkı özdeşliğini kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-036", "zorluk": "orta", "soru": "(x + 1)(x + 5) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 5", "B": "x² + 5x + 5", "C": "x² + 6x + 6", "D": "x² + 6x + 5" }, "dogruCevap": "D", "cozum": "(x + 1)(x + 5) = x² + 5x + x + 5 = x² + 6x + 5.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-037", "zorluk": "orta", "soru": "4x · 2x çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "8x²", "B": "6x²", "C": "8x", "D": "6x" }, "dogruCevap": "A", "cozum": "4x · 2x = (4·2)(x·x) = 8x².", "kazanim": "Tek terimlileri çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-038", "zorluk": "orta", "soru": "(3x + 1)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "9x² + 1", "B": "9x² + 6x + 1", "C": "3x² + 6x + 1", "D": "9x² + 3x + 1" }, "dogruCevap": "B", "cozum": "(3x + 1)² = (3x)² + 2·3x·1 + 1 = 9x² + 6x + 1.", "kazanim": "(a + b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-039", "zorluk": "orta", "soru": "x = 4 için x² + 2x ifadesinin değeri kaçtır?", "siklar": { "A": "20", "B": "18", "C": "24", "D": "12" }, "dogruCevap": "C", "cozum": "4² + 2·4 = 16 + 8 = 24.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-040", "zorluk": "orta", "soru": "(x − 7)(x + 7) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 49", "B": "x − 49", "C": "x² − 14x + 49", "D": "x² − 49" }, "dogruCevap": "D", "cozum": "İki kare farkı: (x − 7)(x + 7) = x² − 49.", "kazanim": "İki kare farkı özdeşliğini kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-041", "zorluk": "zor", "soru": "(x + 4)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 8x + 16", "B": "x² + 16", "C": "x² + 4x + 16", "D": "x² + 8x + 8" }, "dogruCevap": "A", "cozum": "(x + 4)² = x² + 2·x·4 + 16 = x² + 8x + 16.", "kazanim": "(a + b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-042", "zorluk": "zor", "soru": "(2x − 5)(2x + 5) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "4x² + 25", "B": "4x² − 25", "C": "2x² − 25", "D": "4x² − 20x + 25" }, "dogruCevap": "B", "cozum": "İki kare farkı: (2x − 5)(2x + 5) = (2x)² − 5² = 4x² − 25.", "kazanim": "İki kare farkı özdeşliğini kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-043", "zorluk": "zor", "soru": "(x + 3)² − (x − 3)² ifadesinin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "6x", "B": "x²", "C": "12x", "D": "18" }, "dogruCevap": "C", "cozum": "(x+3)² = x²+6x+9, (x−3)² = x²−6x+9. Farkı = 12x.", "kazanim": "Özdeşlikleri birlikte kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-044", "zorluk": "zor", "soru": "(3x + 2)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "9x² + 4", "B": "9x² + 6x + 4", "C": "3x² + 12x + 4", "D": "9x² + 12x + 4" }, "dogruCevap": "D", "cozum": "(3x + 2)² = (3x)² + 2·3x·2 + 4 = 9x² + 12x + 4.", "kazanim": "(a + b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-045", "zorluk": "zor", "soru": "(x − 6)(x + 2) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² − 4x − 12", "B": "x² + 4x − 12", "C": "x² − 4x + 12", "D": "x² − 8x − 12" }, "dogruCevap": "A", "cozum": "(x − 6)(x + 2) = x² + 2x − 6x − 12 = x² − 4x − 12.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-046", "zorluk": "zor", "soru": "x = 5 için 3x + 7 ifadesinin değeri kaçtır?", "siklar": { "A": "20", "B": "22", "C": "17", "D": "26" }, "dogruCevap": "B", "cozum": "3·5 + 7 = 15 + 7 = 22.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-047", "zorluk": "zor", "soru": "(x + 8)(x − 3) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² − 5x − 24", "B": "x² + 5x + 24", "C": "x² + 5x − 24", "D": "x² + x − 24" }, "dogruCevap": "C", "cozum": "(x + 8)(x − 3) = x² − 3x + 8x − 24 = x² + 5x − 24.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-048", "zorluk": "zor", "soru": "4(x + 2) + 2(x − 5) ifadesinin sadeleştirilmiş hâli aşağıdakilerden hangisidir?", "siklar": { "A": "6x + 2", "B": "4x − 2", "C": "6x + 8", "D": "6x − 2" }, "dogruCevap": "D", "cozum": "4(x+2) + 2(x−5) = 4x + 8 + 2x − 10 = 6x − 2.", "kazanim": "Dağılma ve benzer terimleri birlikte uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-049", "zorluk": "kolay", "soru": "7x + 2x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "9x", "B": "14x", "C": "5x", "D": "72x" }, "dogruCevap": "A", "cozum": "Benzer terimler toplanır: 7x + 2x = 9x.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-050", "zorluk": "kolay", "soru": "10x − 4x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "14x", "B": "6x", "C": "40x", "D": "6x²" }, "dogruCevap": "B", "cozum": "Benzer terimler çıkarılır: 10x − 4x = 6x.", "kazanim": "Benzer terimleri çıkarır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-051", "zorluk": "kolay", "soru": "4(x + 3) ifadesinin dağılma ile açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x + 12", "B": "4x + 3", "C": "4x + 12", "D": "4x + 7" }, "dogruCevap": "C", "cozum": "4(x + 3) = 4·x + 4·3 = 4x + 12.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-052", "zorluk": "kolay", "soru": "x(x + 5) çarpımının açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x + 5", "B": "5x²", "C": "2x + 5", "D": "x² + 5x" }, "dogruCevap": "D", "cozum": "x·x + x·5 = x² + 5x.", "kazanim": "Tek terimliyle çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-053", "zorluk": "kolay", "soru": "3x + 7 + 2x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "5x + 7", "B": "12x", "C": "5x + 12", "D": "6x + 7" }, "dogruCevap": "A", "cozum": "Benzer terimler: 3x + 2x = 5x; sabit 7. Sonuç 5x + 7.", "kazanim": "Benzer terimleri gruplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-054", "zorluk": "kolay", "soru": "8x − 3x + x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "4x", "B": "6x", "C": "12x", "D": "5x" }, "dogruCevap": "B", "cozum": "8x − 3x + x = 6x.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-055", "zorluk": "kolay", "soru": "2(x + 4) + 3 ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "2x + 4", "B": "2x + 7", "C": "2x + 11", "D": "5x + 4" }, "dogruCevap": "C", "cozum": "2(x + 4) + 3 = 2x + 8 + 3 = 2x + 11.", "kazanim": "Dağılma ve toplamayı birlikte uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-056", "zorluk": "kolay", "soru": "6(x − 2) ifadesinin dağılma ile açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "6x − 2", "B": "x − 12", "C": "6x + 12", "D": "6x − 12" }, "dogruCevap": "D", "cozum": "6(x − 2) = 6x − 12.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-057", "zorluk": "orta", "soru": "(x + 5)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 10x + 25", "B": "x² + 25", "C": "x² + 5x + 25", "D": "x² + 10x + 10" }, "dogruCevap": "A", "cozum": "(x + 5)² = x² + 2·x·5 + 25 = x² + 10x + 25.", "kazanim": "(a + b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-058", "zorluk": "orta", "soru": "(x − 4)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 8x + 16", "B": "x² − 8x + 16", "C": "x² − 16", "D": "x² − 4x + 16" }, "dogruCevap": "B", "cozum": "(x − 4)² = x² − 2·x·4 + 16 = x² − 8x + 16.", "kazanim": "(a − b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-059", "zorluk": "orta", "soru": "(x + 7)(x − 7) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 49", "B": "x² − 14x − 49", "C": "x² − 49", "D": "x² − 7" }, "dogruCevap": "C", "cozum": "İki kare farkı: (x + 7)(x − 7) = x² − 49.", "kazanim": "İki kare farkını kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-060", "zorluk": "orta", "soru": "(x + 2)(x + 6) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 12x + 8", "B": "x² + 8x + 8", "C": "x² + 2x + 6", "D": "x² + 8x + 12" }, "dogruCevap": "D", "cozum": "(x + 2)(x + 6) = x² + 6x + 2x + 12 = x² + 8x + 12.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-061", "zorluk": "orta", "soru": "(2x + 3)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "4x² + 12x + 9", "B": "4x² + 9", "C": "2x² + 12x + 9", "D": "4x² + 6x + 9" }, "dogruCevap": "A", "cozum": "(2x + 3)² = (2x)² + 2·2x·3 + 9 = 4x² + 12x + 9.", "kazanim": "(a + b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-062", "zorluk": "orta", "soru": "(x − 5)(x + 3) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 2x − 15", "B": "x² − 2x − 15", "C": "x² − 15", "D": "x² − 8x − 15" }, "dogruCevap": "B", "cozum": "(x − 5)(x + 3) = x² + 3x − 5x − 15 = x² − 2x − 15.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-063", "zorluk": "orta", "soru": "(3x − 1)(3x + 1) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "9x² + 1", "B": "9x² − 6x − 1", "C": "9x² − 1", "D": "3x² − 1" }, "dogruCevap": "C", "cozum": "İki kare farkı: (3x)² − 1² = 9x² − 1.", "kazanim": "İki kare farkını kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-064", "zorluk": "orta", "soru": "(x + 9)(x − 2) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² − 7x − 18", "B": "x² + 11x − 18", "C": "x² + 7x + 18", "D": "x² + 7x − 18" }, "dogruCevap": "D", "cozum": "(x + 9)(x − 2) = x² − 2x + 9x − 18 = x² + 7x − 18.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-065", "zorluk": "zor", "soru": "(x + 4)² − (x − 4)² ifadesinin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "16x", "B": "32x", "C": "8x", "D": "16x²" }, "dogruCevap": "A", "cozum": "(x+4)² = x²+8x+16, (x−4)² = x²−8x+16. Farkı = 16x.", "kazanim": "Özdeşlikleri birlikte kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-066", "zorluk": "zor", "soru": "a = 3 ve b = 2 için (a + b)² ifadesinin değeri kaçtır?", "siklar": { "A": "13", "B": "25", "C": "11", "D": "36" }, "dogruCevap": "B", "cozum": "(a + b)² = (3 + 2)² = 5² = 25.", "kazanim": "Özdeşliğin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-067", "zorluk": "zor", "soru": "2(3x + 1) + 4x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "10x", "B": "6x + 2", "C": "10x + 2", "D": "10x + 6" }, "dogruCevap": "C", "cozum": "2(3x + 1) + 4x = 6x + 2 + 4x = 10x + 2.", "kazanim": "Dağılma ve benzer terimleri uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-068", "zorluk": "zor", "soru": "(2x + 3)(x − 1) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "2x² − x − 3", "B": "2x² + x + 3", "C": "2x² − 3", "D": "2x² + x − 3" }, "dogruCevap": "D", "cozum": "(2x + 3)(x − 1) = 2x² − 2x + 3x − 3 = 2x² + x − 3.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-069", "zorluk": "zor", "soru": "x² + 10x + 25 = (x + a)² özdeşliğinde a kaçtır?", "siklar": { "A": "5", "B": "10", "C": "25", "D": "20" }, "dogruCevap": "A", "cozum": "x² + 10x + 25 = (x + 5)² olduğundan a = 5.", "kazanim": "Tam kare özdeşliğini tanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-070", "zorluk": "zor", "soru": "(x + a)(x − a) = x² − 36 özdeşliğinde a (pozitif) kaçtır?", "siklar": { "A": "9", "B": "6", "C": "36", "D": "18" }, "dogruCevap": "B", "cozum": "a² = 36 olduğundan a = 6.", "kazanim": "İki kare farkını tersten kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-071", "zorluk": "zor", "soru": "3(2x − 1) − (x − 4) ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "5x − 5", "B": "7x + 1", "C": "5x + 1", "D": "5x + 4" }, "dogruCevap": "C", "cozum": "3(2x − 1) − (x − 4) = 6x − 3 − x + 4 = 5x + 1.", "kazanim": "Dağılma ve benzer terimleri uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-072", "zorluk": "zor", "soru": "(x + 1)² + (x − 1)² ifadesinin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "2x²", "B": "2x² + 2x", "C": "x² + 2", "D": "2x² + 2" }, "dogruCevap": "D", "cozum": "(x+1)² = x²+2x+1, (x−1)² = x²−2x+1. Toplam = 2x² + 2.", "kazanim": "Özdeşlikleri birlikte kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-073", "zorluk": "kolay", "soru": "5x + 4x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "9x", "B": "20x", "C": "9", "D": "x" }, "dogruCevap": "A", "cozum": "Benzer terimler toplanır: 5x + 4x = 9x.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-074", "zorluk": "kolay", "soru": "8x − 3x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "11x", "B": "5x", "C": "24x", "D": "5" }, "dogruCevap": "B", "cozum": "Benzer terimler çıkarılır: 8x − 3x = 5x.", "kazanim": "Benzer terimleri çıkarır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-075", "zorluk": "kolay", "soru": "3(x + 2) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "3x + 2", "B": "x + 6", "C": "3x + 6", "D": "3x + 5" }, "dogruCevap": "C", "cozum": "Dağılma özelliği: 3(x + 2) = 3x + 6.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-076", "zorluk": "kolay", "soru": "x(x + 4) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 4", "B": "4x²", "C": "x + 4", "D": "x² + 4x" }, "dogruCevap": "D", "cozum": "x·x + x·4 = x² + 4x.", "kazanim": "Tek terimliyle çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-077", "zorluk": "kolay", "soru": "2x + 3 + 4x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "6x + 3", "B": "9x", "C": "6x + 7", "D": "5x + 3" }, "dogruCevap": "A", "cozum": "Benzer terimler: 2x + 4x = 6x, sabit 3 kalır → 6x + 3.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-078", "zorluk": "kolay", "soru": "5(x − 1) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "5x − 1", "B": "5x − 5", "C": "x − 5", "D": "5x + 5" }, "dogruCevap": "B", "cozum": "Dağılma özelliği: 5(x − 1) = 5x − 5.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-079", "zorluk": "kolay", "soru": "x(x − 6) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² − 6", "B": "x − 6", "C": "x² − 6x", "D": "6x²" }, "dogruCevap": "C", "cozum": "x·x − x·6 = x² − 6x.", "kazanim": "Tek terimliyle çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-080", "zorluk": "kolay", "soru": "7x − 2x + x ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "10x", "B": "4x", "C": "8x", "D": "6x" }, "dogruCevap": "D", "cozum": "7x − 2x + x = 6x.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-081", "zorluk": "orta", "soru": "(x + 5)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 10x + 25", "B": "x² + 25", "C": "x² + 5x + 25", "D": "x² + 10x + 10" }, "dogruCevap": "A", "cozum": "(a+b)² = a² + 2ab + b²: x² + 2·5·x + 25 = x² + 10x + 25.", "kazanim": "Tam kare özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-082", "zorluk": "orta", "soru": "(x − 3)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² − 9", "B": "x² − 6x + 9", "C": "x² + 6x + 9", "D": "x² − 3x + 9" }, "dogruCevap": "B", "cozum": "(a−b)² = a² − 2ab + b²: x² − 6x + 9.", "kazanim": "Tam kare özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-083", "zorluk": "orta", "soru": "(x + 4)(x − 4) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 16", "B": "x² − 8x + 16", "C": "x² − 16", "D": "x² − 8" }, "dogruCevap": "C", "cozum": "İki kare farkı: (a+b)(a−b) = a² − b² → x² − 16.", "kazanim": "İki kare farkını uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-084", "zorluk": "orta", "soru": "(x + 2)(x + 7) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + 14", "B": "x² + 9x + 9", "C": "x² + 5x + 14", "D": "x² + 9x + 14" }, "dogruCevap": "D", "cozum": "x² + 7x + 2x + 14 = x² + 9x + 14.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-085", "zorluk": "orta", "soru": "(2x + 1)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "4x² + 4x + 1", "B": "2x² + 4x + 1", "C": "4x² + 1", "D": "4x² + 2x + 1" }, "dogruCevap": "A", "cozum": "(2x)² + 2·2x·1 + 1² = 4x² + 4x + 1.", "kazanim": "Tam kare özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-086", "zorluk": "orta", "soru": "(x − 6)(x + 2) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² − 4x + 12", "B": "x² − 4x − 12", "C": "x² + 4x − 12", "D": "x² − 12" }, "dogruCevap": "B", "cozum": "x² + 2x − 6x − 12 = x² − 4x − 12.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-087", "zorluk": "orta", "soru": "(3x − 2)(3x + 2) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "9x² + 4", "B": "9x² − 12x − 4", "C": "9x² − 4", "D": "6x² − 4" }, "dogruCevap": "C", "cozum": "İki kare farkı: (3x)² − 2² = 9x² − 4.", "kazanim": "İki kare farkını uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-088", "zorluk": "orta", "soru": "2(x + 3) + 3(x − 1) ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "5x + 9", "B": "5x − 3", "C": "6x + 3", "D": "5x + 3" }, "dogruCevap": "D", "cozum": "2x + 6 + 3x − 3 = 5x + 3.", "kazanim": "Dağılma ve benzer terimleri uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-089", "zorluk": "zor", "soru": "(x + 3)² − (x − 3)² ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "12x", "B": "18", "C": "2x² + 18", "D": "0" }, "dogruCevap": "A", "cozum": "(x²+6x+9) − (x²−6x+9) = 12x.", "kazanim": "Özdeşlikleri birlikte kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-090", "zorluk": "zor", "soru": "a² − b² = (a − b)(a + b) özdeşliğine göre 7² − 3² işleminin sonucu kaçtır?", "siklar": { "A": "16", "B": "40", "C": "58", "D": "21" }, "dogruCevap": "B", "cozum": "(7 − 3)(7 + 3) = 4 · 10 = 40.", "kazanim": "İki kare farkı özdeşliğini sayıya uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-091", "zorluk": "zor", "soru": "(x − 5)(x + 4) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² + x − 20", "B": "x² − 20", "C": "x² − x − 20", "D": "x² − 9x − 20" }, "dogruCevap": "C", "cozum": "x² + 4x − 5x − 20 = x² − x − 20.", "kazanim": "İki terimliyi çarpar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-092", "zorluk": "zor", "soru": "(x + 1)² + (x + 2) ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 2x + 3", "B": "x² + 3x + 1", "C": "x² + 3", "D": "x² + 3x + 3" }, "dogruCevap": "D", "cozum": "(x² + 2x + 1) + (x + 2) = x² + 3x + 3.", "kazanim": "Özdeşlik ve toplamayı birleştirir.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-093", "zorluk": "zor", "soru": "İki kare farkı özdeşliği kullanılarak 21² − 19² işleminin sonucu kaçtır?", "siklar": { "A": "80", "B": "40", "C": "2", "D": "400" }, "dogruCevap": "A", "cozum": "(21 − 19)(21 + 19) = 2 · 40 = 80.", "kazanim": "İki kare farkı özdeşliğini sayıya uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-094", "zorluk": "zor", "soru": "3(2x + 1) − (x − 2) ifadesinin en sade biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "5x + 1", "B": "5x + 5", "C": "7x + 5", "D": "6x + 5" }, "dogruCevap": "B", "cozum": "6x + 3 − x + 2 = 5x + 5.", "kazanim": "Dağılma ve benzer terimleri uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-095", "zorluk": "zor", "soru": "(2x − 3)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "4x² + 9", "B": "2x² − 12x + 9", "C": "4x² − 12x + 9", "D": "4x² − 6x + 9" }, "dogruCevap": "C", "cozum": "(2x)² − 2·2x·3 + 3² = 4x² − 12x + 9.", "kazanim": "Tam kare özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-096", "zorluk": "zor", "soru": "x = 4 için 2x² + 3x ifadesinin değeri kaçtır?", "siklar": { "A": "20", "B": "28", "C": "56", "D": "44" }, "dogruCevap": "D", "cozum": "2·4² + 3·4 = 2·16 + 12 = 32 + 12 = 44.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true }
  ]
}
