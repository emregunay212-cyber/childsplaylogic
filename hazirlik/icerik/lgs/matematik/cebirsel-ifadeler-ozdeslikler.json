  "sorular": [
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-001", "zorluk": "kolay", "soru": "7x − 2x işleminin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "5x", "B": "9x", "C": "14x", "D": "5" }, "dogruCevap": "A", "cozum": "Benzer terimlerin katsayıları çıkarılır: 7x − 2x = (7 − 2)x = 5x.", "kazanim": "Benzer terimlerle işlem yapar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-002", "zorluk": "orta", "soru": "x = 4 için 3x² − 2x ifadesinin değeri kaçtır?", "siklar": { "A": "40", "B": "44", "C": "32", "D": "10" }, "dogruCevap": "A", "cozum": "3·(4²) − 2·4 = 3·16 − 8 = 48 − 8 = 40.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-003", "zorluk": "orta", "soru": "(x + 5)(x − 5) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² − 25", "B": "x² + 25", "C": "x² − 10x + 25", "D": "x² − 5x" }, "dogruCevap": "A", "cozum": "İki kare farkı özdeşliği: (a + b)(a − b) = a² − b². Buradan (x + 5)(x − 5) = x² − 25.", "kazanim": "İki kare farkı özdeşliğini kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-004", "zorluk": "orta", "soru": "6² − 4² işleminin sonucu kaçtır?", "siklar": { "A": "4", "B": "20", "C": "40", "D": "52" }, "dogruCevap": "B", "cozum": "İki kare farkı: 6² − 4² = (6 − 4)(6 + 4) = 2 × 10 = 20. (Doğrudan: 36 − 16 = 20.)", "kazanim": "İki kare farkını sayısal hesapta kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-005", "zorluk": "orta", "soru": "x² − 8x + 16 ifadesinin çarpanlarına ayrılmış biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "(x − 4)²", "B": "(x + 4)²", "C": "(x − 4)(x + 4)", "D": "(x − 8)²" }, "dogruCevap": "A", "cozum": "Tam kare: x² − 8x + 16 = (x)² − 2·x·4 + 4² = (x − 4)².", "kazanim": "Tam kare ifadeyi çarpanlarına ayırır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-006", "zorluk": "kolay", "soru": "2(3x − 1) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "6x − 2", "B": "6x − 1", "C": "5x − 1", "D": "6x + 2" }, "dogruCevap": "A", "cozum": "Dağılma özelliği: 2·3x − 2·1 = 6x − 2.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-007", "zorluk": "zor", "soru": "a + b = 8 ve a·b = 12 olduğuna göre a² + b² kaçtır?", "siklar": { "A": "40", "B": "52", "C": "64", "D": "76" }, "dogruCevap": "A", "cozum": "(a + b)² = a² + 2ab + b² olduğundan a² + b² = (a + b)² − 2ab = 8² − 2·12 = 64 − 24 = 40.", "kazanim": "Özdeşlikle a² + b² değerini bulur.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-008", "zorluk": "orta", "soru": "15x³ ÷ 3x işleminin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "5x²", "B": "5x³", "C": "12x²", "D": "5x" }, "dogruCevap": "A", "cozum": "Katsayılar bölünür (15 ÷ 3 = 5), üslerde çıkarma yapılır (x³ ÷ x = x²): sonuç 5x².", "kazanim": "Cebirsel ifadelerde bölme yapar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-009", "zorluk": "kolay", "soru": "x = 10 için x² − 1 ifadesinin değeri kaçtır?", "siklar": { "A": "99", "B": "100", "C": "19", "D": "101" }, "dogruCevap": "A", "cozum": "10² − 1 = 100 − 1 = 99.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-010", "zorluk": "zor", "soru": "(a − b)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "a² − 2ab + b²", "B": "a² + 2ab + b²", "C": "a² − b²", "D": "a² − ab + b²" }, "dogruCevap": "A", "cozum": "(a − b)² = (a − b)(a − b) = a² − 2ab + b². Ortadaki −2ab terimi unutulmamalı.", "kazanim": "(a − b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-011", "zorluk": "kolay", "soru": "4a + 3a işleminin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "7a", "B": "12a", "C": "7", "D": "a⁷" }, "dogruCevap": "A", "cozum": "Benzer terimlerin katsayıları toplanır: 4a + 3a = 7a.", "kazanim": "Benzer terimlerle işlem yapar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-012", "zorluk": "kolay", "soru": "x = 2 için 5x ifadesinin değeri kaçtır?", "siklar": { "A": "10", "B": "7", "C": "25", "D": "52" }, "dogruCevap": "A", "cozum": "5x = 5 × 2 = 10.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-013", "zorluk": "kolay", "soru": "3(x + 2) ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "3x + 6", "B": "3x + 2", "C": "x + 6", "D": "3x + 5" }, "dogruCevap": "A", "cozum": "Dağılma: 3·x + 3·2 = 3x + 6.", "kazanim": "Dağılma özelliğini uygular.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-014", "zorluk": "kolay", "soru": "8y − 3y işleminin sonucu kaçtır?", "siklar": { "A": "5y", "B": "11y", "C": "5", "D": "24y" }, "dogruCevap": "A", "cozum": "8y − 3y = (8 − 3)y = 5y.", "kazanim": "Benzer terimlerle işlem yapar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-015", "zorluk": "kolay", "soru": "x = 3 için x + 7 ifadesinin değeri kaçtır?", "siklar": { "A": "10", "B": "21", "C": "73", "D": "4" }, "dogruCevap": "A", "cozum": "x + 7 = 3 + 7 = 10.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-016", "zorluk": "orta", "soru": "(x + 2)(x − 2) çarpımı aşağıdakilerden hangisine eşittir?", "siklar": { "A": "x² − 4", "B": "x² + 4", "C": "x² − 4x + 4", "D": "x² − 2x" }, "dogruCevap": "A", "cozum": "İki kare farkı: (x + 2)(x − 2) = x² − 2² = x² − 4.", "kazanim": "İki kare farkı özdeşliğini kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-017", "zorluk": "orta", "soru": "x = 5 için 2x² − 3 ifadesinin değeri kaçtır?", "siklar": { "A": "47", "B": "97", "C": "7", "D": "19" }, "dogruCevap": "A", "cozum": "2·(5²) − 3 = 2·25 − 3 = 50 − 3 = 47.", "kazanim": "Cebirsel ifadenin değerini hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-018", "zorluk": "orta", "soru": "(x + 3)² ifadesinin açılımı aşağıdakilerden hangisidir?", "siklar": { "A": "x² + 9", "B": "x² + 6x + 9", "C": "x² + 3x + 9", "D": "x² + 6x" }, "dogruCevap": "B", "cozum": "(x + 3)² = x² + 2·x·3 + 3² = x² + 6x + 9.", "kazanim": "(a + b)² özdeşliğini açar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-019", "zorluk": "zor", "soru": "a + b = 10 ve a·b = 21 ise a² + b² kaçtır?", "siklar": { "A": "58", "B": "142", "C": "79", "D": "100" }, "dogruCevap": "A", "cozum": "a² + b² = (a + b)² − 2ab = 10² − 2·21 = 100 − 42 = 58.", "kazanim": "Özdeşlikle a² + b² bulur.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-020", "zorluk": "zor", "soru": "7² − 3² işleminin sonucu kaçtır?", "siklar": { "A": "16", "B": "40", "C": "58", "D": "20" }, "dogruCevap": "B", "cozum": "İki kare farkı: 7² − 3² = (7 − 3)(7 + 3) = 4 × 10 = 40. (49 − 9 = 40.)", "kazanim": "İki kare farkını sayısal hesapta kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-021", "zorluk": "zor", "soru": "x² − 10x + 25 ifadesinin çarpanlarına ayrılmış biçimi aşağıdakilerden hangisidir?", "siklar": { "A": "(x − 5)²", "B": "(x + 5)²", "C": "(x − 5)(x + 5)", "D": "(x − 10)²" }, "dogruCevap": "A", "cozum": "x² − 10x + 25 = x² − 2·x·5 + 5² = (x − 5)².", "kazanim": "Tam kare ifadeyi çarpanlarına ayırır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-022", "zorluk": "zor", "soru": "x = 4 için (x − 1)(x + 1) ifadesinin değeri kaçtır?", "siklar": { "A": "15", "B": "17", "C": "16", "D": "8" }, "dogruCevap": "A", "cozum": "(4 − 1)(4 + 1) = 3 × 5 = 15. (Veya x² − 1 = 16 − 1 = 15.)", "kazanim": "İki kare farkını sayıyla hesaplar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-023", "zorluk": "zor", "soru": "6x²y ÷ 2xy işleminin sonucu aşağıdakilerden hangisidir?", "siklar": { "A": "3x", "B": "3xy", "C": "4x", "D": "3" }, "dogruCevap": "A", "cozum": "Katsayı: 6÷2 = 3. x²÷x = x, y÷y = 1. Sonuç 3x.", "kazanim": "Cebirsel ifadelerde bölme yapar.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-024", "zorluk": "zor", "soru": "a − b = 5 ve a + b = 9 ise a² − b² kaçtır?", "siklar": { "A": "45", "B": "4", "C": "14", "D": "40" }, "dogruCevap": "A", "cozum": "a² − b² = (a − b)(a + b) = 5 × 9 = 45.", "kazanim": "İki kare farkı özdeşliğini kullanır.", "dogrulandi": true },
    { "id": "lgs-mat-cebirsel-ifadeler-ozdeslikler-025", "zorluk": "kolay", "soru": "4x + 3x ifadesinin sadeleştirilmiş hâli aşağıdakilerden hangisidir?", "siklar": { "A": "7x", "B": "12x", "C": "7x²", "D": "x" }, "dogruCevap": "A", "cozum": "Benzer terimler: 4x + 3x = 7x.", "kazanim": "Benzer terimleri toplar.", "dogrulandi": true },
