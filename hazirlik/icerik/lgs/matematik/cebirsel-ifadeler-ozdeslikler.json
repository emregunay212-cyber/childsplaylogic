          { "soru": "(x + 5)(x − 5) çarpımını bul.", "adimlar": ["İki kare farkı: (a + b)(a − b) = a² − b²", "a = x, b = 5"], "sonuc": "(x + 5)(x − 5) = x² − 25" },
          { "soru": "x² − 8x + 16 ifadesini çarpanlarına ayır.", "adimlar": ["Ortadaki −8x = −2·x·4, son terim 16 = 4²", "Tam kare kalıbı: (x − 4)²"], "sonuc": "x² − 8x + 16 = (x − 4)²" },
          { "soru": "a + b = 8 ve ab = 12 ise a² + b² kaçtır?", "adimlar": ["(a+b)² = a² + 2ab + b²", "a² + b² = (a+b)² − 2ab = 64 − 24"], "sonuc": "a² + b² = 40" }
        ]
      },
      {
        "tip": "dene",
        "baslik": "6. Şimdi Sıra Sende!",
