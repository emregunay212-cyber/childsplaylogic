          { "soru": "Gücü 100 W olan bir alet 10 saniye çalışırsa harcadığı enerji kaç J'dür?", "adimlar": ["E = P · t", "E = 100 · 10 = 1000"], "sonuc": "1000 J" },
          { "soru": "Gücü 200 W olan bir alet 20 V ile çalışıyorsa çektiği akım kaç A'dir?", "adimlar": ["P = V · I → I = P / V", "I = 200 / 20 = 10"], "sonuc": "10 A" }
        ]
